# Paid mainnet RPC (e.g. Helius). Server-side only; the browser talks to it through /api/rpc.
# Public mainnet RPC works for light local testing but rate-limits quickly.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Public origin used in Blink icons when not on Vercel. Optional locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: conversion deadlines not yet in src/lib/config.ts, as JSON {"SYMBOL":"YYYY-MM-DD"}.
# NEXT_PUBLIC_CONVERSION_DEADLINES={"ANTHROPIC":"2026-12-15"}
